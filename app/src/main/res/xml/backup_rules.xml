<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Auto Backup rules.
    Only the settings DataStore is included. As soon as an <include> is present, everything
    else (encrypted databases, biometric credential storage, cached import/export files)
    is excluded implicitly.
-->
<full-backup-content>
    <!-- Include settings DataStore -->
    <include domain="file" path="datastore/settings.preferences_pb" />

</full-backup-content>
